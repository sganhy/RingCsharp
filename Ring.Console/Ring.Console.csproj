<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <OutputType>Exe</OutputType>
	  <TargetFramework>net8.0</TargetFramework>
	  <PlatformTarget>x64</PlatformTarget>
	  <Platforms>x64</Platforms>
	  <LangVersion>10.0</LangVersion>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <AnalysisLevel>6.0-recommended</AnalysisLevel>
	  <AssemblyVersion>1.0.1.0</AssemblyVersion>
	  <FileVersion>1.0.1.0</FileVersion>
	  <SignAssembly>True</SignAssembly>
	  <PublishTrimmed>True</PublishTrimmed>
	  <PublishAot>True</PublishAot>
	  <AssemblyOriginatorKeyFile>Ring.Console.snk</AssemblyOriginatorKeyFile>
	  <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.DotNet.ILCompiler" />
		<PackageReference Include="Microsoft.NET.ILLink.Tasks" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\Ring.PostgreSQL\Ring.PostgreSQL.csproj" />
	  <ProjectReference Include="..\Ring\Ring.csproj" />
	</ItemGroup>


</Project>
