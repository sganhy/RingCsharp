<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
 		<Nullable>enable</Nullable>
 		<LangVersion>10.0</LangVersion>
		<Platforms>x64</Platforms>
		<AnalysisLevel>8.0-all</AnalysisLevel>
		<AssemblyVersion>1.0.0.328</AssemblyVersion>
		<FileVersion>1.0.0.328</FileVersion>
		<RepositoryType>https://github.com/sganhy/RingCsharp.git</RepositoryType>
		<RepositoryUrl>https://github.com/sganhy/RingCsharp</RepositoryUrl>
		<Description>Ring Zero</Description>
		<Title>Ring 0</Title>
		<Version>1.0.0-beta</Version>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<NoWarn>CA1307;CA1802;S3267;IDE0066</NoWarn>
		<PublishTrimmed>True</PublishTrimmed>
		<PublishAot>True</PublishAot>
		<IsAotCompatible>true</IsAotCompatible>
		<VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>Ring.snk</AssemblyOriginatorKeyFile>
		<Copyright>Copyright © 2025</Copyright>
		<NuGetAuditLevel>critical</NuGetAuditLevel>
		<Product>Ring Zero</Product>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<IsAotCompatible>True</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<DebugType>full</DebugType>
		<WarningLevel>6</WarningLevel>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<IsAotCompatible>True</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<WarningLevel>6</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Util\Resources\MethodInfo.gz" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Util\Resources\LogMessage.gz" />
		<EmbeddedResource Include="Util\Resources\MethodInfo.gz" />
		<EmbeddedResource Include="Util\Resources\MySQLReservedKeyWord.gz" />
		<EmbeddedResource Include="Util\Resources\OracleReservedKeyWord.gz" />
		<EmbeddedResource Include="Util\Resources\Parameter.gz" />
		<EmbeddedResource Include="Util\Resources\PostgreSQLReservedKeyWord.gz" />
		<EmbeddedResource Include="Util\Resources\SQLiteReservedKeyWord.gz" />
		<EmbeddedResource Include="Util\Resources\SQLServerReservedKeyWord.gz" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Ring.Tests" PublicKey="" />
		<InternalsVisibleTo Include="Ring.Schema.Tests" PublicKey="" />
		<InternalsVisibleTo Include="Ring.InfluxDB" PublicKey="" />
		<InternalsVisibleTo Include="Ring.MySql" PublicKey="" />
		<InternalsVisibleTo Include="Ring.Oracle" PublicKey="" />
		<InternalsVisibleTo Include="Ring.PostgreSQL" PublicKey="" />
		<InternalsVisibleTo Include="Ring.Sqlite" PublicKey="" />
		<InternalsVisibleTo Include="Ring.Schema" PublicKey="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.DotNet.ILCompiler" />
		<PackageReference Include="Microsoft.NET.ILLink.Tasks" />
	</ItemGroup>
 
</Project>
